{
  "name": "scale",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "android": "lingui compile --strict && APP_VARIANT=development expo run:android",
    "android:release": "lingui compile --strict && APP_VARIANT=production expo run:android --variant release",
    "check": "vp check --fix && pnpm run typecheck && vp test run",
    "export": "lingui compile --strict && expo export --platform android",
    "generate": "lingui compile --strict && expo prebuild --platform android",
    "i18n:compile": "lingui compile --strict",
    "i18n:extract": "lingui extract --clean",
    "icons:generate": "node scripts/generate-icons.mjs",
    "licenses:generate": "node scripts/generate-licenses.ts",
    "lint": "vp lint --fix",
    "prepare": "vp config",
    "start": "lingui compile --strict && expo start --dev-client",
    "test": "vp test run",
    "test:android": "cd android && ./gradlew :scale:testDebugUnitTest",
    "typecheck": "lingui compile --strict && tsc --noEmit"
  },
  "dependencies": {
    "@expo/material-symbols": "0.1.1",
    "@expo/metro-runtime": "58.0.17",
    "@expo/ui": "58.0.29",
    "@formatjs/intl-getcanonicallocales": "3.4.0",
    "@formatjs/intl-locale": "5.5.0",
    "@formatjs/intl-pluralrules": "7.1.0",
    "@lingui/core": "6.12.0",
    "@lingui/react": "6.12.0",
    "expo": "58.0.26",
    "expo-application": "58.1.2",
    "expo-build-properties": "58.0.12",
    "expo-constants": "58.0.16",
    "expo-dev-client": "58.0.21",
    "expo-file-system": "58.0.14",
    "expo-linking": "58.0.17",
    "expo-localization": "58.0.5",
    "expo-router": "58.0.32",
    "expo-sqlite": "58.0.18",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "6.12.0",
    "@lingui/cli": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@oxlint/plugins": "1.94.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.26",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite-plus": "1.7.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26.8.1"
  },
  "packageManager": "pnpm@12.22.0"
}
